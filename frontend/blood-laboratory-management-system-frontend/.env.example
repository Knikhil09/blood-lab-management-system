# Demo adapter stays on unless explicitly disabled.
VITE_USE_MOCK_API=true

# Gateway default for a locally running Spring Boot API Gateway.
VITE_API_BASE_URL=http://localhost:8081

# Optional route overrides. Defaults live in src/api/apiRoutes.js.
# VITE_AUTH_LOGIN_PATH=/api/auth/login
# VITE_AUTH_LOGOUT_PATH=/api/auth/logout
# VITE_PATIENTS_PATH=/api/patients
# VITE_TESTS_PATH=/api/tests
# VITE_REPORTS_PATH=/api/reports
